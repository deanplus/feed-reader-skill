{
  "name": "feed-reader-skill",
  "version": "0.3.5",
  "description": "Read RSS, Atom, and configured web feeds through a TypeScript CLI and agent skill.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deanplus/feed-reader-skill.git"
  },
  "homepage": "https://github.com/deanplus/feed-reader-skill#readme",
  "bugs": "https://github.com/deanplus/feed-reader-skill/issues",
  "bin": {
    "feed-reader": "bin/feed-reader.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "README.zh-CN.md",
    "bin",
    "dist",
    "skills/feed-reader"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --import tsx --test --test-concurrency=1 test/**/*.test.ts",
    "test:coverage": "npm run build && node --import tsx --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=src/**/*.ts --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.1.2",
    "fast-xml-parser": "^5.3.6",
    "playwright-core": "^1.62.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
